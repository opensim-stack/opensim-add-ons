{
	"name": "console2mcp",
	"description": "Bridges the OpenSimulator REST console to MCP so bots can run admin commands.",
	"icon" : "console2mcp.svg",
	"version": "0.0.1",
	"constants": {
	    "OPENSIM_CONSOLE2MCP_IMAGE": "%cfg.group%opensim-console2mcp:%grid.updates.tag%",
	    "CONSOLE_MCP_TRANSPORT": "http",
	    "CONSOLE_MCP_HOST": "0.0.0.0",
        "CONSOLE_MCP_PORT": "8997"
    },
    "tokens": [
        "CONSOLE_MCP_HTTP_BEARER_TOKEN"
    ],
    "hooks": {
        "POST_INSTALL": [
            {
                "type": "createJson",
                "addOn": "BOT",
                "level": "GOVERNOR",
                "path": "/config/bots/%bot.name%/opencode.json",
                "jsonPath": "mcp",
                "mode": "merge",
                "json": {
                   "console2mcp": {
                        "type": "remote",
                        "url": "http://%cfg.projectName%-console2mcp:%env.CONSOLE_MCP_PORT%/mcp",
                        "enabled": true,
                        "headers": {
                            "Authorization": "Bearer %token.CONSOLE_MCP_HTTP_BEARER_TOKEN%"
                        }
                    }
                }
            }
        ],
        "PRE_UNINSTALL": [
            {
                "type": "deleteJson",
                "addOn": "BOT",
                "level": "GOVERNOR",
                "path": "/config/bots/%bot.name%/opencode.json",
                "jsonPath": "/mcp/console2mcp"
            }
        ]
    },
	"extensions": {
		"SIMULATOR": {
			"containers": {
				"%env.OPENSIM_CONSOLE2MCP_IMAGE%": {
					"name": "%cfg.projectName%-console2mcp",
					"environment": {
					    "CONSOLE_MCP_TRANSPORT": "%env.CONSOLE_MCP_TRANSPORT%",
                        "CONSOLE_MCP_HOST": "%env.CONSOLE_MCP_HOST%",
                        "CONSOLE_MCP_PORT": "%env.CONSOLE_MCP_PORT%",
                        "CONSOLE_MCP_HTTP_BEARER_TOKEN": "%token.CONSOLE_MCP_HTTP_BEARER_TOKEN%",
                        "OPENSIM_CONSOLE_URL": "http://%cfg.projectName%-grid-services:%sim.port%",
                        "OPENSIM_CONSOLE_USER": "%grid.consoleUser%",
                        "OPENSIM_CONSOLE_PASS": "%grid.consolePass%"
					}
				}
			}
		}
	}
}
