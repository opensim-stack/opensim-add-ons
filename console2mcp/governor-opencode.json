{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "console2mcp": {
      "type": "remote",
      "url": "http://%env.COMPOSE_PROJECT_NAME%-console2mcp-1:%env.CONSOLE_MCP_PORT%/mcp",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer %token.CONSOLE_MCP_HTTP_BEARER_TOKEN%"
      }
    }
  }
}
