{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "read": {
      "/workspace/blender/**": "allow",
      "/workspace/blender": "allow"
    },
    "write": {
      "/workspace/blender/**": "allow",
      "/workspace/blender": "allow"
    },
    "external_directory": {
      "/workspace/blender/**": "allow",
      "/workspace/blender": "allow"
    }
  },
  "mcp": {
    "blender_mcp": {
      "type": "remote",
      "url": "http://%env.COMPOSE_PROJECT_NAME%-blender:%env.BLENDER_MCP_PORT%/mcp",
      "enabled": true
    }
  }
}
