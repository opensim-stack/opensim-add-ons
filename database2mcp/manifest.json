{
	"name": "database2mcp",
	"description": "Bridges the OpenSimulator Database console to MCP so bots can directly query and update data.",
	"icon" : "database2mcp.svg",
	"version": "0.0.1",
	"constants": {
	    "OPENSIM_DATABASE2MCP_IMAGE": "%cfg.group%opensim-database2mcp:%grid.updates.tag%",
	    "DATABASE_MCP_TRANSPORT": "sse",
	    "DATABASE_MCP_HOST": "0.0.0.0",
        "DATABASE_MCP_PORT": "8992",
        "DATABASE_MCP_SSE_ROOT_PATH": "/mcp/sse",
        "MARIADB_HOST": "%cfg.projectNameE%-mariadb",
        "MARIADB_USER": "opensim",
        "MARIADB_DATABASE": "opensim"
    },
	"extensions": {
		"SIMULATOR": {
			"containers": {
				"%env.OPENSIM_DATABASE2MCP_IMAGE%": {
					"name": "%cfg.projectName%-database2mcp",
					"environment": {
					    "DATABASE_MCP_TRANSPORT": "%env.DATABASE_MCP_TRANSPORT%",
                        "DATABASE_MCP_HOST": "%env.DATABASE_MCP_HOST%",
                        "DATABASE_MCP_PORT": "%env.DATABASE_MCP_PORT%",
                        "DATABASE_MCP_SSE_ROOT_PATH": "%env.DATABASE_MCP_SSE_ROOT_PATH%",
                        "JDBC_URL": "jdbc:mariadb://%env.MARIADB_HOST%:3306/%env.MARIADB_DATABASE%",
                        "JDBC_USER": "%env.MARIADB_USER%",
                        "JDBC_PASSWORD": "%token.MARIADB_PASSWORD%"
					},
                    "managed": [
                        {
                        "resource": "governor-opencode.json",
                        "dropIns": "/config/drop-ins/opencode/opencode.json.d"
                        },
                        {
                        "resource": "builder-opencode.json",
                        "dropIns": "/config/drop-ins/opencode/opencode.json.d"
                        },
                        {
                        "resource": "actor-opencode.json",
                        "dropIns": "/config/drop-ins/opencode/opencode.json.d"
                        }
                    ]
				}
			}
		}
	}
}
