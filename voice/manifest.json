{
	"name": "voice",
	"description": "Adds voice abilities to bots by the way of Piper and Janus.",
	"icon": "voice.svg",
	"version": "0.0.1",
	"tokens": [
	   "JANUS_API_TOKEN",
	   "JANUS_ADMIN_TOKEN"
    ],
	"constants": {
	    "VOICE_ROUTING_ENABLED": "true",
        "VOICE_BACKEND": "webrtc",
		"OPENSIM_PIPER_IMAGE": "bithatch/opensim-piper:latest",
		"OPENSIM_JANUS_IMAGE": "misterblue/os-webrtc-janus-docker:latest",
		"JANUS_HTTP_PORT" : "14223",
        "JANUS_ADMIN_PORT" : "14225",
        "JANUS_UDP_RTP_MIN" : "10000",
        "JANUS_UDP_RTP_MAX" : "10200",
        "JANUS_SERVER_NAME": "GridVoice",
        "JANUS_HTTP_ENABLE": "true",
        "JANUS_HTTP_BASEPATH": "/voice",
        "JANUS_HTTPS_ENABLE": "false",
        "JANUS_HTTPS_PORT": "14224",
        "JANUS_HTTP_ADMIN_ENABLE": "true",
        "JANUS_HTTP_ADMIN_PORT": "14225",
        "JANUS_HTTP_ADMIN_BASEPATH": "/voiceAdmin",
		"PIPER_HTTP_HOST": "0.0.0.0",
        "PIPER_SCHEME": "http",
        "PIPER_HOST": "%cfg.composeProjectName%-piper",
		"PIPER_PORT": "8995",
		"PIPER_TTS_PATH": "/tts",
		"PIPER_VOICES_PATH": "/voices",
		"PIPER_DEFAULT_VOICE": "en_US-lessac-medium",
		"PIPER_REQUEST_TIMEOUT_SECONDS": "60",
		"PIPER_TIMEOUT_SECONDS": "60",
		"OPENSIM_JANUS_PUBLIC_HOST": "%env.OPENSIM_HOSTNAME%"
	},
	"exports": [
        "VOICE_ROUTING_ENABLED",
        "VOICE_BACKEND",
        "PIPER_SCHEME",
        "PIPER_HOST",
        "PIPER_PORT",
        "PIPER_TTS_PATH",
        "PIPER_VOICES_PATH",
        "PIPER_REQUEST_TIMEOUT_SECONDS",
        "PIPER_DEFAULT_VOICE"
    ],
	"hooks": {
        "POST_INSTALL": [
            {
                "type": "copy",
                "addOn": "SIMULATOR",
                "level": "STANDALONE",
                "source": "standalone-os-webrtc-janus.ini",
                "target": "/config/sims/%sim.name%/config-include/os-webrtc-janus.ini"
            },{
                "type": "copy",
                "addOn": "SIMULATOR",
                "level": "GRID",
                "source": "grid-os-webrtc-janus.ini",
                "target": "/config/sims/%sim.name%/config-include/os-webrtc-janus.ini"
            },{
                "type": "createIniKey",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "ServiceList",
                "key": "VoiceServiceConnector",
                "value": "${Const|PrivatePort}/WebRtcVoice.dll:WebRtcVoiceServerConnector"
            },{
                "type": "createIniKey",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "WebRtcVoice",
                "key": "Enabled",
                "value": "true"
            },{
                "type": "createIniKey",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "WebRtcVoice",
                "key": "SpatialVoiceService",
                "value": "WebRtcJanusService.dll:WebRtcJanusService"
            },{
                "type": "createIniKey",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "WebRtcVoice",
                "key": "NonSpatialVoiceService",
                "value": "WebRtcJanusService.dll:WebRtcJanusService"
            },{
                "type": "createIniKey",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "JanusWebRtcVoice",
                "key": "JanusGatewayURI",
                "value": "http://%env.OPENSIM_JANUS_PUBLIC_HOST%:%env.JANUS_HTTP_ADMIN_PORT%%env.JANUS_HTTP_BASEPATH%"
            },{
                "type": "createIniKey",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "JanusWebRtcVoice",
                "key": "APIToken",
                "value": "%token.JANUS_API_TOKEN%"
            },{
                "type": "createIniKey",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "JanusWebRtcVoice",
                "key": "JanusGatewayAdminURI",
                "value": "http://%env.OPENSIM_JANUS_PUBLIC_HOST%:%env.JANUS_HTTP_ADMIN_PORT%%env.JANUS_HTTP_ADMIN_BASEPATH%"
            },{
                "type": "createIniKey",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "JanusWebRtcVoice",
                "key": "AdminAPIToken",
                "value": "%token.JANUS_ADMIN_TOKEN%"
            },{
                "type": "createIniKey",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "JanusWebRtcVoice",
                "key": "MessageDetails",
                "value": "true"
            }
        ],
        "PRE_UNINSTALL": [
            {
                "type": "delete",
                "addOn": "SIMULATOR",
                "level": "STANDALONE",
                "path": "/config/sims/%sim.name%/config-include/os-webrtc-janus.ini"
            },{
                "type": "delete",
                "addOn": "SIMULATOR",
                "level": "GRID",
                "path": "/config/sims/%sim.name%/config-include/os-webrtc-janus.ini"
            },{
                "type": "deleteIni",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "ServiceList",
                "key": "VoiceServiceConnector"
            },{
                "type": "deleteIni",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "WebRtcVoice"
            },{
                "type": "deleteIni",
                "addOn": "SIMULATOR",
                "level": "ROBUST",
                "path": "/config/sims/%sim.name%/Robust.ini",
                "section": "JanusWebRtcVoice"
            }
        ]
    },
	"extensions": {
		"STACK": {
			"containers": {
				"%env.OPENSIM_PIPER_IMAGE%": {
					"name": "%cfg.composeProjectName%-piper",
					"environment": {
						"PIPER_HTTP_HOST": "%env.PIPER_HTTP_HOST%",
						"PIPER_HTTP_PORT": "%env.PIPER_PORT%",
						"PIPER_DEFAULT_VOICE": "%env.PIPER_DEFAULT_VOICE%",
						"PIPER_TIMEOUT_SECONDS": "%env.PIPER_TIMEOUT_SECONDS%"
					},
					"volumes": {
						"piper-voices" : "/voices"
					}
				},
				"%env.OPENSIM_JANUS_IMAGE%": {
                    "name": "%cfg.composeProjectName%-janus",
                    "volumes": {
                        "opensim-janus-config" : "/opt/janus/etc/janus"
                    },
                    "ports": {
                        "%env.JANUS_HTTP_PORT%/tcp": "%env.JANUS_HTTP_PORT%",
                        "%env.JANUS_ADMIN_PORT%/tcp": "%env.JANUS_ADMIN_PORT%",
                        "%env.JANUS_UDP_RTP_MIN%-%env.JANUS_UDP_RTP_MAX%/udp": "%env.JANUS_UDP_RTP_MIN%-%env.JANUS_UDP_RTP_MAX%"
                    },
                    "healthcheck": {
                        "test": ["CMD", "curl", "-f", "http://localhost:%env.JANUS_HTTP_PORT%/"],
                        "interval": 10,
                        "timeout": 5,
                        "retries": 24,
                        "startPeriod": 15
                    },
                    "init" : {
                        "%env.OPENSIM_JANUS_IMAGE%": {
                            "entryPoint": ["/bin/bash", "-c", "/config/add-ons/voice/init.sh"],
                            "volumes": {
                                "opensim-janus-config" : "/janus-config",
                                "%env.COMPOSE_PROJECT_NAME%_opensim-config": "/config"
                            },
                            "environment": {
                                "JANUS_SERVER_NAME": "%env.JANUS_SERVER_NAME%",
                                "JANUS_HTTP_ENABLE": "%env.JANUS_HTTP_ENABLE%",
                                "JANUS_HTTP_PORT": "%env.JANUS_HTTP_PORT%",
                                "JANUS_HTTP_BASEPATH": "%env.JANUS_HTTP_BASEPATH%",
                                "JANUS_HTTPS_ENABLE": "%env.JANUS_HTTPS_ENABLE%",
                                "JANUS_HTTPS_PORT": "%env.JANUS_HTTPS_PORT%",
                                "JANUS_HTTP_ADMIN_ENABLE": "%env.JANUS_HTTP_ADMIN_ENABLE%",
                                "JANUS_HTTP_ADMIN_PORT": "%env.JANUS_HTTP_ADMIN_PORT%",
                                "JANUS_HTTP_ADMIN_BASEPATH": "%env.JANUS_HTTP_ADMIN_BASEPATH%",
                                "JANUS_API_TOKEN": "%token.JANUS_API_TOKEN%",
                                "JANUS_ADMIN_TOKEN": "%token.JANUS_ADMIN_TOKEN%"
                            }
                        }
                    }
                }
			}
		}
	}
}
