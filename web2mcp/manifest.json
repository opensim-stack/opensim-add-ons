{
	"name": "web2mcp",
	"description": "Adds a Firecrawl MCP server so agents can browse and extract web content. Note that OpenCode based bots do have some basic web fetching capabiltiies, this supercharges those abilties!",
	"icon": "web2mcp.svg",
	"version": "0.0.1",
	"constants": {
		"OPENSIM_WEB2MCP_IMAGE": "mcp/firecrawl:latest",
		"WEB2MCP_TRANSPORT": "http",
		"WEB2MCP_PORT": "3000",
		"WEB2MCP_ENDPOINT": "/mcp",
		"FIRECRAWL_API_URL": "https://api.firecrawl.dev",
		"FIRECRAWL_API_KEY": ""
	},
	"tokens": [
	],
    "configuration": [
        {
            "name": "FIRECRAWL_API_KEY",
            "type": "TEXT",
            "description": "Firecrawl API Key. Sign-up at https://www.firecrawl.dev/."
        }
    ],
    "hooks": {
        "POST_INSTALL": [
            {
                "type": "createJson",
                "addOn": "BOT",
                "level": "GOVERNOR",
                "path": "/config/bots/%bot.name%/opencode.json",
                "jsonPath": "mcp",
                "mode": "merge",
                "json": {
                   "web2mcp": {
                      "type": "remote",
                      "url": "http://%cfg.projectName%-web2mcp:%env.WEB2MCP_PORT%%env.WEB2MCP_ENDPOINT%",
                      "enabled": true,
                      "headers": {
                        "Authorization": "Bearer %env.FIRECRAWL_API_KEY%"
                      }
                    }
                }
            },
            {
                "type": "createJson",
                "addOn": "BOT",
                "level": "BUILDER",
                "path": "/config/bots/%bot.name%/opencode.json",
                "jsonPath": "mcp",
                "mode": "merge",
                "json": {
                   "web2mcp": {
                      "type": "remote",
                      "url": "http://%cfg.projectName%-web2mcp:%env.WEB2MCP_PORT%%env.WEB2MCP_ENDPOINT%",
                      "enabled": true,
                      "headers": {
                        "Authorization": "Bearer %env.FIRECRAWL_API_KEY%"
                      }
                    }
                }
            }
        ],
        "PRE_UNINSTALL": [
            {
                "type": "deleteJson",
                "addOn": "BOT",
                "level": "GOVERNOR",
                "path": "/config/bots/%bot.name%/opencode.json",
                "jsonPath": "/mcp/web2mcp"
            },
            {
                "type": "deleteJson",
                "addOn": "BOT",
                "level": "BUILDER",
                "path": "/config/bots/%bot.name%/opencode.json",
                "jsonPath": "/mcp/web2mcp"
            }
        ]
    },
	"extensions": {
		"STACK": {
			"containers": {
				"%env.OPENSIM_WEB2MCP_IMAGE%": {
					"name": "%cfg.projectName%-web2mcp",
					"environment": {
				        "HOST": "0.0.0.0",
						"HTTP_STREAMABLE_SERVER": "true",
						"FIRECRAWL_API_KEY": "%env.FIRECRAWL_API_KEY%",
						"FIRECRAWL_API_URL": "%env.FIRECRAWL_API_URL%"
					}
				}
			}
		}
	}
}
